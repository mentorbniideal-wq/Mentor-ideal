# ============================================================
# BNI IDEAL Mentor System — Environment Variables
# Copy this file to .env (never commit .env to git)
# ============================================================

# ── Supabase ─────────────────────────────────────────────────
MY_IDEAL_ENV=local
RELEASE_SHA=local
# Required in staging/production validation; protected deploy configuration, never browser JS.
PRODUCTION_SUPABASE_URL=https://<production-project-ref>.supabase.co
PUBLIC_APP_URL=http://localhost:3000
MSB_FORM_URL=http://localhost:3000/member-success-blueprint
LINE_LIFF_URL=http://localhost:3000/liff/
LINE_DELIVERY_ENABLED=false
# Build-only public artifact inputs. These values are safe to expose; do not add service keys here.
PUBLIC_SUPABASE_URL=http://localhost:54321
PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>
PUBLIC_LINE_LIFF_ID=
SUPABASE_URL=https://<PROJECT_REF>.supabase.co
SUPABASE_ANON_KEY=<your-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>
# Required for secure Digital Handshake hashes. Generate a long random value.
ONE_TO_ONE_CODE_PEPPER=<random-secret-string>

# ── LINE Messaging API ────────────────────────────────────────
# Get from LINE Developers Console → Messaging API channel
# MUST use Messaging API (not LINE Notify — that service is discontinued)
LINE_CHANNEL_ACCESS_TOKEN=<long-lived-channel-access-token>
LINE_CHANNEL_SECRET=<channel-secret-for-webhook-signature-verification>
# Canonical webhook is enabled only in the intended live environment.
LINE_WEBHOOK_ENABLED=true
# Temporary rollback only. Keep false so new users require one-time secure link tokens.
LINE_ALLOW_LEGACY_NAME_REGISTRATION=false
# Legacy LIFF integration identifier. PUBLIC_LINE_LIFF_ID drives the browser artifact.
LINE_LIFF_ID=<your-liff-id>

# ── Anthropic (for AI 1-2-1 matching + PDF check-in parsing) ─
# Store in Supabase Vault, not in plain env where possible
ANTHROPIC_API_KEY=<your-anthropic-api-key>
# Model override (optional — defaults to claude-haiku-4-5-20251001 in settings table)
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ── Cron secret (shared between pg_cron job and Edge Function) ─
# Generate with: openssl rand -base64 32
CRON_SECRET=<random-secret-string>

# ── Runtime mode ─────────────────────────────────────────────
# Set DEV_MODE=true for internal testing only. In production, set to false.
DEV_MODE=true

# ── Local development only ────────────────────────────────────
# These are set automatically when using `supabase start`
# SUPABASE_URL=http://localhost:54321
# SUPABASE_ANON_KEY=<local-anon-key>
# SUPABASE_SERVICE_ROLE_KEY=<local-service-role-key>

# ── Notes ─────────────────────────────────────────────────────
# PINs are stored as bcrypt hashes in the roles table — never here.
# LINE_TOKEN (LINE Notify) is deprecated and NOT used in this system.
# The MC's LINE User ID is stored in the settings table (key: MC_LINE_USER_ID).
