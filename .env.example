# ============================================================
# BNI IDEAL Mentor System — Environment Variables
# Copy this file to .env (never commit .env to git)
# ============================================================

# ── Supabase ─────────────────────────────────────────────────
SUPABASE_URL=https://<PROJECT_REF>.supabase.co
SUPABASE_ANON_KEY=<your-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>

# ── LINE Messaging API ────────────────────────────────────────
# Get from LINE Developers Console → Messaging API channel
# MUST use Messaging API (not LINE Notify — that service is discontinued)
LINE_CHANNEL_ACCESS_TOKEN=<long-lived-channel-access-token>
LINE_CHANNEL_SECRET=<channel-secret-for-webhook-signature-verification>

# ── Anthropic (for AI 1-2-1 matching + PDF check-in parsing) ─
# Store in Supabase Vault, not in plain env where possible
ANTHROPIC_API_KEY=<your-anthropic-api-key>
# Model override (optional — defaults to claude-haiku-4-5-20251001 in settings table)
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ── Cron secret (shared between pg_cron job and Edge Function) ─
# Generate with: openssl rand -base64 32
CRON_SECRET=<random-secret-string>

# ── Runtime mode ─────────────────────────────────────────────
# Set DEV_MODE=true for internal testing only. In production, set to false.
DEV_MODE=true

# ── Local development only ────────────────────────────────────
# These are set automatically when using `supabase start`
# SUPABASE_URL=http://localhost:54321
# SUPABASE_ANON_KEY=<local-anon-key>
# SUPABASE_SERVICE_ROLE_KEY=<local-service-role-key>

# ── Notes ─────────────────────────────────────────────────────
# PINs are stored as bcrypt hashes in the roles table — never here.
# LINE_TOKEN (LINE Notify) is deprecated and NOT used in this system.
# The MC's LINE User ID is stored in the settings table (key: MC_LINE_USER_ID).
